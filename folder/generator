class MatrixCell(QLineEdit):
    """
    One editable variable inside a matrix.
    """

    enterPressed = Signal(object)
    ctrlEnterPressed = Signal(object)

    def __init__(self, value="", parent=None):
        super().__init__(parent)

        self.setText(value_to_text(value))

        self.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.setMinimumWidth(80)
        self.setMaximumWidth(160)
        self.setMinimumHeight(38)

        self.setFont(QFont("Segoe UI", 11))

        self.setStyleSheet("""
            QLineEdit {
                background: #151821;
                color: #e9edf5;
                border: 1px solid #343b4d;
                border-radius: 7px;
                padding: 5px 8px;
            }

            QLineEdit:focus {
                border: 2px solid #667eea;
                background: #1b2030;
            }
        """)

    def keyPressEvent(self, event):

        if (
            event.key() == Qt.Key.Key_Return
            or event.key() == Qt.Key.Key_Enter
        ):

            if event.modifiers() & Qt.KeyboardModifier.ControlModifier:
                self.ctrlEnterPressed.emit(self)
            else:
                self.enterPressed.emit(self)

            return

        super().keyPressEvent(event)



# ============================================================
# VALUE CONVERSION
# ============================================================

def parse_value(text):
    """
    Convert text into int/float when possible.
    Otherwise keep it as a string.

    Examples:

        "10"      -> 10
        "-4"      -> -4
        "3.14"    -> 3.14
        "hello"   -> "hello"
        "3e5"     -> 300000.0
    """

    text = text.strip()

    if text == "":
        return None

    try:
        if text.lower().startswith(("0x", "-0x", "+0x")):
            return int(text, 16)

        if any(c in text.lower() for c in [".", "e"]):
            return float(text)

        return int(text)

    except ValueError:
        return text


def value_to_text(value):
    """
    Convert Python values back to text for the matrix file.
    """

    if value is None:
        return ""

    if isinstance(value, float):
        if math.isfinite(value):
            return format(value, ".15g")

    return str(value)


# ============================================================
# MATRIX FILE FORMAT
# ============================================================

def load_matrix_file(path):
    """
    Read a matrix file.

    Format:

        1 2 3
        4 5 6

        10 20
        30 40

        100 200 300

    Blank lines separate matrices.
    Lines separate rows.
    Whitespace separates variables.
    """

    matrices = []

    if not path.exists():
        return matrices

    current_matrix = []

    try:
        with path.open("r", encoding="utf-8") as file:
            for raw_line in file:
                line = raw_line.rstrip("\n\r")

                # Blank line = end of matrix
                if not line.strip():
                    if current_matrix:
                        matrices.append(current_matrix)
                        current_matrix = []

                    continue

                values = line.split()

                row = [parse_value(value) for value in values]

                current_matrix.append(row)

        # File may not end with a blank line.
        if current_matrix:
            matrices.append(current_matrix)

    except OSError as error:
        raise RuntimeError(f"Could not read file:\n{error}")

    return matrices


def save_matrix_file(path, matrices):
    """
    Save all matrices using the simple text format.
    """

    path.parent.mkdir(parents=True, exist_ok=True)

    try:
        with path.open("w", encoding="utf-8") as file:

            for matrix_index, matrix in enumerate(matrices):

                for row in matrix:
                    values = [
                        value_to_text(value)
                        for value in row
                    ]

                    # Remove empty trailing variables.
                    while values and values[-1] == "":
                        values.pop()

                    if values:
                        file.write(" ".join(values))

                    file.write("\n")

                # Blank line separates matrices.
                if matrix_index < len(matrices) - 1:
                    file.write("\n")

    except OSError as error:
        raise RuntimeError(f"Could not save file:\n{error}")



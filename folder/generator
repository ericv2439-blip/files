class MatrixWidget(QFrame):
    """
    Displays and edits one matrix.

    Supports jagged matrices:

        1 2 3
        4 5
        6 7 8 9
    """

    matrixFinished = Signal(object)
    matrixChanged = Signal()

    def __init__(self, matrix, matrix_number, parent=None):
        super().__init__(parent)

        self.matrix_number = matrix_number

        # Deep copy.
        self.matrix = [
            list(row)
            for row in matrix
        ]

        self.cells = []

        self.setFrameShape(QFrame.Shape.StyledPanel)

        self.setStyleSheet("""
            QFrame {
                background: #0e1118;
                border: 1px solid #252b38;
                border-radius: 12px;
            }
        """)

        self.outer_layout = QVBoxLayout(self)
        self.outer_layout.setContentsMargins(14, 12, 14, 14)
        self.outer_layout.setSpacing(10)

        # ----------------------------------------------------
        # HEADER
        # ----------------------------------------------------

        header = QHBoxLayout()

        self.title = QLabel(
            f"Matrix {self.matrix_number}"
        )

        self.title.setFont(
            QFont("Segoe UI", 13, QFont.Weight.Bold)
        )

        self.title.setStyleSheet(
            "color: #dce3f1; border: none;"
        )

        header.addWidget(self.title)

        header.addStretch()

        self.info_label = QLabel()
        self.info_label.setStyleSheet(
            "color: #727b8f; border: none;"
        )

        header.addWidget(self.info_label)

        self.outer_layout.addLayout(header)

        # ----------------------------------------------------
        # SCROLLABLE MATRIX AREA
        # ----------------------------------------------------

        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.Shape.NoFrame)

        self.matrix_container = QWidget()

        self.grid = QGridLayout(
            self.matrix_container
        )

        self.grid.setContentsMargins(5, 5, 5, 5)
        self.grid.setHorizontalSpacing(6)
        self.grid.setVerticalSpacing(6)

        self.scroll.setWidget(
            self.matrix_container
        )

        self.outer_layout.addWidget(
            self.scroll,
            1
        )

        # ----------------------------------------------------
        # BUTTONS
        # ----------------------------------------------------

        button_layout = QHBoxLayout()

        add_cell_button = QPushButton(
            "+ Variable"
        )

        add_row_button = QPushButton(
            "+ Row"
        )

        finish_button = QPushButton(
            "Finish Matrix"
        )

        add_cell_button.clicked.connect(
            self.add_variable
        )

        add_row_button.clicked.connect(
            self.add_row
        )

        finish_button.clicked.connect(
            self.finish_matrix
        )

        for button in (
            add_cell_button,
            add_row_button,
            finish_button,
        ):
            button.setMinimumHeight(34)

        button_layout.addWidget(add_cell_button)
        button_layout.addWidget(add_row_button)

        button_layout.addStretch()

        button_layout.addWidget(finish_button)

        self.outer_layout.addLayout(
            button_layout
        )

        # Keyboard shortcut.
        shortcut = QShortcut(
            QKeySequence("Ctrl+Return"),
            self
        )

        shortcut.activated.connect(
            self.finish_matrix
        )

        self.rebuild()

    # --------------------------------------------------------
    # REBUILD GUI
    # --------------------------------------------------------

    def rebuild(self, focus_cell=None):

        while self.grid.count():
            item = self.grid.takeAt(0)

            widget = item.widget()

            if widget:
                widget.deleteLater()

        self.cells.clear()

        if not self.matrix:
            self.matrix = [[]]

        # Guarantee at least one row.
        if len(self.matrix) == 0:
            self.matrix.append([])

        # Guarantee a first variable for a new matrix.
        if len(self.matrix) == 1 and len(self.matrix[0]) == 0:
            self.matrix[0].append("")

        max_columns = max(
            (len(row) for row in self.matrix),
            default=1
        )

        # Column labels.
        for column in range(max_columns):
            label = QLabel(
                f"C{column + 1}"
            )

            label.setAlignment(
                Qt.AlignmentFlag.AlignCenter
            )

            label.setStyleSheet("""
                QLabel {
                    color: #687286;
                    border: none;
                    font-size: 10px;
                }
            """)

            self.grid.addWidget(
                label,
                0,
                column + 1
            )

        # Rows.
        for row_index, row in enumerate(self.matrix):

            row_label = QLabel(
                f"R{row_index + 1}"
            )

            row_label.setAlignment(
                Qt.AlignmentFlag.AlignCenter
            )

            row_label.setStyleSheet("""
                QLabel {
                    color: #687286;
                    border: none;
                    font-size: 10px;
                }
            """)

            self.grid.addWidget(
                row_label,
                row_index + 1,
                0
            )

            row_cells = []

            for column_index, value in enumerate(row):

                cell = MatrixCell(
                    value,
                    self
                )

                cell.enterPressed.connect(
                    self.handle_enter
                )

                cell.ctrlEnterPressed.connect(
                    self.handle_ctrl_enter
                )

                cell.textChanged.connect(
                    self.matrixChanged.emit
                )

                self.grid.addWidget(
                    cell,
                    row_index + 1,
                    column_index + 1
                )

                row_cells.append(cell)

                self.cells.append(
                    (
                        row_index,
                        column_index,
                        cell
                    )
                )

                self.apply_cell_color(
                    cell,
                    row_index,
                    column_index,
                    max_columns
                )

        self.info_label.setText(
            f"{len(self.matrix)} rows"
        )

        if focus_cell is not None:
            focus_cell.setFocus()
            focus_cell.selectAll()

    # --------------------------------------------------------
    # COLORING
    # --------------------------------------------------------

    def apply_cell_color(
        self,
        cell,
        row,
        column,
        max_columns
    ):

        max_rows = max(
            len(self.matrix) - 1,
            1
        )

        x = (
            column / max(max_columns - 1, 1)
        )

        y = (
            row / max_rows
        )

        # Position-based visual color.
        #
        # Left = darker
        # Right = more green
        # Top = less blue
        # Bottom = more blue

        red = 20

        green = int(
            35 + (x * 80)
        )

        blue = int(
            45 + (y * 75)
        )

        border_green = min(
            green + 15,
            255
        )

        border_blue = min(
            blue + 15,
            255
        )

        cell.setStyleSheet(f"""
            QLineEdit {{
                background: rgb(
                    {red},
                    {green},
                    {blue}
                );

                color: #edf2ff;

                border: 1px solid rgb(
                    52,
                    {border_green},
                    {border_blue}
                );

                border-radius: 7px;
                padding: 5px 8px;
            }}

            QLineEdit:focus {{
                border: 2px solid #9baaff;

                background: rgb(
                    {red + 5},
                    {min(green + 15, 255)},
                    {min(blue + 15, 255)}
                );
            }}
        """)

    # --------------------------------------------------------
    # FIND CELL
    # --------------------------------------------------------

    def find_cell(self, widget):

        for index, (
            row,
            column,
            cell
        ) in enumerate(self.cells):

            if cell is widget:
                return index, row, column

        return None

    # --------------------------------------------------------
    # ENTER
    # --------------------------------------------------------

    def handle_enter(self, widget):

        location = self.find_cell(widget)

        if location is None:
            return

        index, row, column = location

        # ----------------------------------------------------
        # EMPTY CELL
        # ----------------------------------------------------

        if widget.text().strip() == "":

            # If there is another variable in the current row,
            # simply move to it.
            if index + 1 < len(self.cells):

                next_cell = self.cells[index + 1][2]

                next_cell.setFocus()
                next_cell.selectAll()

                return

            # Otherwise an empty final variable means:
            #
            # END MATRIX
            #
            self.finish_matrix()
            return

        # ----------------------------------------------------
        # NORMAL CELL
        # ----------------------------------------------------

        if index + 1 < len(self.cells):

            next_cell = self.cells[index + 1][2]

            next_cell.setFocus()
            next_cell.selectAll()

            return

        # Last variable.
        #
        # Enter at the end finishes this matrix.
        self.finish_matrix()

    # --------------------------------------------------------
    # CTRL + ENTER
    # --------------------------------------------------------

    def handle_ctrl_enter(self, widget=None):

        self.finish_matrix()

    # --------------------------------------------------------
    # ADD VARIABLE
    # --------------------------------------------------------

    def add_variable(self):

        if not self.matrix:
            self.matrix.append([])

        self.matrix[-1].append("")

        self.rebuild()

        # Focus newly created variable.
        if self.cells:
            self.cells[-1][2].setFocus()

    # --------------------------------------------------------
    # ADD ROW
    # --------------------------------------------------------

    def add_row(self):

        self.matrix.append(
            [""]
        )

        self.rebuild()

        if self.cells:
            self.cells[-1][2].setFocus()

    # --------------------------------------------------------
    # EXTRACT CURRENT DATA
    # --------------------------------------------------------

    def get_matrix(self):

        result = []

        for row in self.matrix:

            result.append(
                list(row)
            )

        for row_index, row in enumerate(result):

            for column_index in range(
                len(row)
            ):

                matching_cell = None

                for (
                    r,
                    c,
                    cell
                ) in self.cells:

                    if (
                        r == row_index
                        and c == column_index
                    ):
                        matching_cell = cell
                        break

                if matching_cell:
                    row[column_index] = parse_value(
                        matching_cell.text()
                    )

        # Remove empty trailing cells.
        for row in result:

            while row and row[-1] is None:
                row.pop()

        # Remove completely empty trailing rows.
        while result and not result[-1]:
            result.pop()

        return result

    # --------------------------------------------------------
    # FINISH
    # --------------------------------------------------------

    def finish_matrix(self):

        self.matrix = self.get_matrix()

        self.matrixChanged.emit()

        self.matrixFinished.emit(
            self
        )

        # Don't steal focus aggressively.
        self.clearFocus()



    # ========================================================
    # FOLDER TREE
    # ========================================================

    def refresh_folders(self):

        self.folder_tree.clear()

        root_item = QTreeWidgetItem(
            [
                "📁 MatrixData"
            ]
        )

        root_item.setData(
            0,
            Qt.ItemDataRole.UserRole,
            str(ROOT_DIR)
        )

        self.folder_tree.addTopLevelItem(
            root_item
        )

        self.populate_folder_tree(
            root_item,
            ROOT_DIR
        )

        root_item.setExpanded(
            True
        )

    def populate_folder_tree(
        self,
        parent_item,
        directory
    ):

        try:
            folders = sorted(
                [
                    path
                    for path in directory.iterdir()
                    if path.is_dir()
                ],
                key=lambda p: p.name.lower()
            )

        except OSError:
            return

        for folder in folders:

            item = QTreeWidgetItem(
                [
                    f"📁 {folder.name}"
                ]
            )

            item.setData(
                0,
                Qt.ItemDataRole.UserRole,
                str(folder)
            )

            parent_item.addChild(
                item
            )

            self.populate_folder_tree(
                item,
                folder
            )

    # ========================================================
    # FOLDER CLICK
    # ========================================================

    def folder_clicked(
        self,
        item,
        column
    ):

        path_string = item.data(
            0,
            Qt.ItemDataRole.UserRole
        )

        if not path_string:
            return

        path = Path(
            path_string
        )

        if not path.exists():
            return

        self.current_folder = path

        self.path_label.setText(
            str(path)
        )

        self.refresh_files()

    # ========================================================
    # FILE LIST
    # ========================================================

    def refresh_files(self):

        self.file_list.clear()

        if not self.current_folder.exists():
            return

        try:
            files = sorted(
                [
                    path
                    for path in self.current_folder.iterdir()
                    if (
                        path.is_file()
                        and path.suffix.lower()
                        == MATRIX_EXTENSION
                    )
                ],
                key=lambda p: p.name.lower()
            )

        except OSError:
            return

        for file_path in files:

            item = QListWidgetItem(
                f"📄 {file_path.name}"
            )

            item.setData(
                Qt.ItemDataRole.UserRole,
                str(file_path)
            )

            self.file_list.addItem(
                item
            )

    # ========================================================
    # CREATE FOLDER
    # ========================================================

    def create_folder(self):

        name, accepted = QInputDialog.getText(
            self,
            "New Folder",
            "Folder name:"
        )

        if not accepted:
            return

        name = name.strip()

        if not name:
            return

        # Prevent path traversal.
        if (
            "/" in name
            or "\\" in name
            or name in (".", "..")
        ):
            QMessageBox.warning(
                self,
                "Invalid Folder Name",
                "The folder name cannot contain / or \\."
            )

            return

        folder = (
            self.current_folder
            / name
        )

        if folder.exists():

            QMessageBox.warning(
                self,
                "Folder Exists",
                "That folder already exists."
            )

            return

        try:

            folder.mkdir(
                parents=False,
                exist_ok=False
            )

        except OSError as error:

            QMessageBox.critical(
                self,
                "Could Not Create Folder",
                str(error)
            )

            return

        self.refresh_folders()

        self.refresh_files()

    # ========================================================
    # DELETE FOLDER
    # ========================================================

    def delete_folder(self):

        if self.current_folder == ROOT_DIR:

            QMessageBox.warning(
                self,
                "Cannot Delete Root",
                "The MatrixData root folder cannot be deleted."
            )

            return

        try:
            contents = list(
                self.current_folder.iterdir()
            )

        except OSError as error:

            QMessageBox.critical(
                self,
                "Error",
                str(error)
            )

            return

        # IMPORTANT:
        # Only empty folders can be deleted.
        if contents:

            QMessageBox.warning(
                self,
                "Folder Is Not Empty",
                "Only completely empty folders can be deleted."
            )

            return

        answer = QMessageBox.question(
            self,
            "Delete Folder",
            (
                f"Delete empty folder?\n\n"
                f"{self.current_folder.name}"
            ),
            QMessageBox.StandardButton.Yes
            | QMessageBox.StandardButton.No
        )

        if answer != QMessageBox.StandardButton.Yes:
            return

        folder_to_delete = self.current_folder

        parent = folder_to_delete.parent

        try:
            folder_to_delete.rmdir()

        except OSError as error:

            QMessageBox.critical(
                self,
                "Could Not Delete Folder",
                str(error)
            )

            return

        self.current_folder = parent

        self.path_label.setText(
            str(parent)
        )

        self.refresh_folders()
        self.refresh_files()

    # ========================================================
    # CREATE MATRIX FILE
    # ========================================================

    def create_matrix_file(self):

        filename, accepted = QInputDialog.getText(
            self,
            "New Matrix File",
            "File name:"
        )

        if not accepted:
            return

        filename = filename.strip()

        if not filename:
            return

        # Automatically add extension.
        if not filename.lower().endswith(
            MATRIX_EXTENSION
        ):
            filename += MATRIX_EXTENSION

        # Prevent path traversal.
        if (
            "/" in filename
            or "\\" in filename
        ):

            QMessageBox.warning(
                self,
                "Invalid File Name",
                "The file name cannot contain / or \\."
            )

            return

        path = (
            self.current_folder
            / filename
        )

        if path.exists():

            QMessageBox.warning(
                self,
                "File Exists",
                "That matrix file already exists."
            )

            return

        try:

            save_matrix_file(
                path,
                []
            )

        except RuntimeError as error:

            QMessageBox.critical(
                self,
                "Could Not Create File",
                str(error)
            )

            return

        self.refresh_files()

        self.open_file(
            path
        )

    # ========================================================
    # OPEN FILE
    # ========================================================

    def file_double_clicked(
        self,
        item
    ):

        path_string = item.data(
            Qt.ItemDataRole.UserRole
        )

        if not path_string:
            return

        self.open_file(
            Path(path_string)
        )

    def open_file(self, path):

        try:

            self.matrices = load_matrix_file(
                path
            )

        except RuntimeError as error:

            QMessageBox.critical(
                self,
                "Could Not Open File",
                str(error)
            )

            return

        self.current_file = path

        self.file_title.setText(
            path.name
        )

        self.render_matrices()

    # ========================================================
    # RENDER MATRICES
    # ========================================================

    def render_matrices(self):

        # Remove old widgets.
        while self.matrix_layout.count():

            item = self.matrix_layout.takeAt(0)

            widget = item.widget()

            if widget:
                widget.deleteLater()

        self.matrix_widgets.clear()

        self.matrix_count_label.setText(
            f"Matrices: {len(self.matrices)}"
        )

        # Existing matrices.
        for index, matrix in enumerate(
            self.matrices
        ):

            widget = MatrixWidget(
                matrix,
                index + 1
            )

            widget.matrixFinished.connect(
                self.matrix_finished
            )

            widget.matrixChanged.connect(
                self.live_matrix_changed
            )

            self.matrix_widgets.append(
                widget
            )

            self.matrix_layout.addWidget(
                widget
            )

        # If the file has no matrices,
        # show an empty state.
        if not self.matrices:

            empty_label = QLabel(
                "This file contains no matrices.\n"
                "Press '+ New Matrix' to begin."
            )

            empty_label.setAlignment(
                Qt.AlignmentFlag.AlignCenter
            )

            empty_label.setStyleSheet("""
                QLabel {
                    color: #667086;
                    padding: 80px;
                    font-size: 15px;
                }
            """)

            self.matrix_layout.addWidget(
                empty_label
            )

        self.matrix_layout.addStretch()

    # ========================================================
    # MATRIX CHANGED
    # ========================================================

    def live_matrix_changed(self):

        # Keep the model synchronized with
        # whatever the user currently typed.
        self.sync_from_widgets()

    # ========================================================
    # SYNC GUI -> PYTHON
    # ========================================================

    def sync_from_widgets(self):

        if not self.matrix_widgets:
            return

        self.matrices = []

        for widget in self.matrix_widgets:

            self.matrices.append(
                widget.get_matrix()
            )

        self.matrix_count_label.setText(
            f"Matrices: {len(self.matrices)}"
        )

    # ========================================================
    # MATRIX FINISHED
    # ========================================================

    def matrix_finished(
        self,
        widget
    ):

        self.sync_from_widgets()

        # Automatically save.
        self.save_current_file(
            silent=True
        )

        # Focus the next matrix if it exists.
        try:
            index = self.matrix_widgets.index(
                widget
            )

        except ValueError:
            return

        next_index = index + 1

        if (
            next_index
            < len(self.matrix_widgets)
        ):

            next_widget = (
                self.matrix_widgets[next_index]
            )

            if next_widget.cells:

                next_widget.cells[0][2].setFocus()

    # ========================================================
    # ADD MATRIX
    # ========================================================

    def add_matrix(self):

        if self.current_file is None:

            QMessageBox.information(
                self,
                "No File",
                "Open or create a matrix file first."
            )

            return

        # Save current GUI state first.
        self.sync_from_widgets()

        new_matrix = [
            [""]
        ]

        self.matrices.append(
            new_matrix
        )

        self.render_matrices()

        # Focus first variable of new matrix.
        if self.matrix_widgets:

            widget = self.matrix_widgets[-1]

            if widget.cells:
                widget.cells[0][2].setFocus()

        self.save_current_file(
            silent=True
        )

    # ========================================================
    # SAVE
    # ========================================================

    def save_current_file(
        self,
        checked=False,
        silent=False
    ):

        if self.current_file is None:

            if not silent:

                QMessageBox.information(
                    self,
                    "No File",
                    "There is no matrix file open."
                )

            return

        self.sync_from_widgets()

        try:

            save_matrix_file(
                self.current_file,
                self.matrices
            )

        except RuntimeError as error:

            QMessageBox.critical(
                self,
                "Could Not Save",
                str(error)
            )

            return

        if not silent:

            self.statusBar().showMessage(
                "Saved.",
                2500
            )



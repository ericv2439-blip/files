# ==========================================
# AI REASONING
# ==========================================

def ask_ai(goal, screenshot):

    image = add_coordinate_grid(screenshot)

    encoded_image = encode_image(image)

    recent_history = json.dumps(
        list(history),
        ensure_ascii=False
    )

    response = client.responses.create(
        model=MODEL,

        instructions=SYSTEM_PROMPT,

        input=[
            {
                "role": "user",
                "content": [
                    {
                        "type": "input_text",
                        "text": (
                            f"OBJECTIVE:\n{goal}\n\n"
                            f"RECENT ACTION HISTORY:\n"
                            f"{recent_history}\n\n"
                            "Examine the current screenshot "
                            "and choose the next action."
                        )
                    },
                    {
                        "type": "input_image",
                        "image_url": encoded_image,
                        "detail": "high"
                    }
                ]
            }
        ],

        text={
            "format": {
                "type": "json_schema",
                "name": "computer_action",
                "strict": True,
                "schema": ACTION_SCHEMA
            }
        }
    )

    return json.loads(response.output_text)


# ==========================================
# ACTION EXECUTION
# ==========================================

ALLOWED_KEYS = {
    "enter", "esc", "tab", "space",
    "backspace", "delete",
    "up", "down", "left", "right",
    "home", "end", "pageup", "pagedown",
    "ctrl", "shift", "alt", "command",
    "a", "c", "v", "x", "z", "y", "s",
    "f", "n", "t", "w", "r",
    "f1", "f2", "f3", "f4", "f5",
    "f6", "f7", "f8", "f9", "f10",
    "f11", "f12"
}

BLOCKED_SHORTCUTS = {
    ("alt", "f4"),
    ("ctrl", "alt", "delete"),
    ("command", "q")
}


def execute_action(command):

    action = command["action"]

    x, y = to_screen_coordinates(
        command["x"],
        command["y"]
    )

    if action == "move":
        pyautogui.moveTo(
            x, y, duration=0.3
        )

    elif action == "click":
        pyautogui.click(x, y)

    elif action == "double_click":
        pyautogui.doubleClick(
            x, y, interval=0.12
        )

    elif action == "right_click":
        pyautogui.rightClick(x, y)

    elif action == "drag":
        x2, y2 = to_screen_coordinates(
            command["x2"],
            command["y2"]
        )

        pyautogui.moveTo(x, y, duration=0.2)

        pyautogui.dragTo(
            x2, y2,
            duration=0.6,
            button="left"
        )

    elif action == "scroll":
        amount = max(
            -5,
            min(5, command["amount"])
        )

        pyautogui.moveTo(x, y)
        pyautogui.scroll(amount)

    elif action == "type":
        text = command["text"][:500]

        pyautogui.write(
            text,
            interval=0.01
        )

    elif action == "press":
        key = command["key"].lower()

        if key not in ALLOWED_KEYS:
            raise ValueError(
                f"Key not permitted: {key}"
            )

        pyautogui.press(key)

    elif action == "hotkey":
        keys = [
            key.lower()
            for key in command["keys"]
        ]

        if not keys or len(keys) > 3:
            raise ValueError(
                "Invalid shortcut"
            )

        if not all(
            key in ALLOWED_KEYS
            for key in keys
        ):
            raise ValueError(
                "Shortcut contains invalid keys"
            )

        if tuple(keys) in BLOCKED_SHORTCUTS:
            raise ValueError(
                "Shortcut blocked"
            )

        pyautogui.hotkey(*keys)

    elif action == "wait":
        time.sleep(1)

    elif action == "done":
        return False

    else:
        raise ValueError(
            f"Unknown action: {action}"
        )

    return True


# ==========================================
# MAIN AGENT LOOP
# ==========================================

def run_agent(goal):

    print("\nAION NEXUS ONLINE")
    print("Model:", MODEL)
    print("Objective:", goal)

    print(
        "\nEMERGENCY STOP:"
        "\nMove mouse to top-left corner"
        "\nor press Ctrl+C in terminal.\n"
    )

    worker = threading.Thread(
        target=screenshot_worker,
        daemon=True
    )

    worker.start()

    action_count = 0

    try:
        while (
            not stop_event.is_set()
            and action_count < MAX_ACTIONS
        ):

            with screenshot_lock:
                screenshot = latest_screenshot
                capture_time = latest_screenshot_time

            if screenshot is None:
                time.sleep(0.2)
                continue

            print(
                f"\n[CYCLE {action_count + 1}]"
                f" Screenshot age: "
                f"{time.time() - capture_time:.1f}s"
            )

            command = ask_ai(
                goal,
                screenshot
            )

            print(
                json.dumps(
                    command,
                    indent=2
                )
            )

            print(
                "AI Reason:",
                command["reason"]
            )

            if command["action"] == "done":
                print("\nTASK COMPLETED")
                break

            # Require approval before every action.
            # Remove this only in a controlled,
            # isolated test environment.
            approval = input(
                "Execute action? [y/N]: "
            ).strip().lower()

            if approval != "y":
                print("Action rejected.")
                history.append({
                    "action": command,
                    "result": "REJECTED"
                })
                continue

            try:
                execute_action(command)

                result = "EXECUTED"

            except pyautogui.FailSafeException:
                print("EMERGENCY STOP")
                break

            except Exception as e:
                result = f"ERROR: {e}"

            history.append({
                "action": command,
                "result": result
            })

            action_count += 1

            print("Result:", result)

    except KeyboardInterrupt:
        print("\nUSER STOPPED AGENT")

    finally:
        stop_event.set()
        worker.join(timeout=2)

        print("\nAION NEXUS OFFLINE")


# ==========================================
# START
# ==========================================

if __name__ == "__main__":

    print("=" * 45)
    print("       AION COMPUTER AGENT")
    print("=" * 45)

    objective = input(
        "\nWhat should AION do?\n> "
    )

    run_agent(objective)




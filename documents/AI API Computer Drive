# ==========================================
# SCREENSHOT CAPTURE
# ==========================================

def screenshot_worker():
    global latest_screenshot
    global latest_screenshot_time

    while not stop_event.is_set():
        try:
            image = pyautogui.screenshot()

            with screenshot_lock:
                latest_screenshot = image
                latest_screenshot_time = time.time()

        except Exception as e:
            print("Screenshot error:", e)

        stop_event.wait(SCREENSHOT_INTERVAL)


# ==========================================
# COORDINATE GRID
# ==========================================

def add_coordinate_grid(image):
    image = image.copy().convert("RGB")

    original_width, original_height = image.size

    if original_width > MAX_IMAGE_WIDTH:
        ratio = MAX_IMAGE_WIDTH / original_width

        image = image.resize(
            (
                MAX_IMAGE_WIDTH,
                int(original_height * ratio)
            ),
            Image.Resampling.LANCZOS
        )

    width, height = image.size

    draw = ImageDraw.Draw(image)

    # Grid every 100 normalized units
    for value in range(0, 1001, 100):

        x = int(value / COORD_MAX * (width - 1))
        y = int(value / COORD_MAX * (height - 1))

        draw.line(
            [(x, 0), (x, height)],
            fill=(0, 255, 100),
            width=1
        )

        draw.line(
            [(0, y), (width, y)],
            fill=(0, 255, 100),
            width=1
        )

        draw.text(
            (min(x + 3, width - 35), 5),
            str(value),
            fill=(0, 255, 100)
        )

        draw.text(
            (5, min(y + 3, height - 15)),
            str(value),
            fill=(0, 255, 100)
        )

    return image


# ==========================================
# IMAGE ENCODING
# ==========================================

def encode_image(image):
    buffer = io.BytesIO()

    image.save(
        buffer,
        format="JPEG",
        quality=75
    )

    encoded = base64.b64encode(
        buffer.getvalue()
    ).decode("utf-8")

    return f"data:image/jpeg;base64,{encoded}"


# ==========================================
# COORDINATE CONVERSION
# ==========================================

def to_screen_coordinates(x, y):
    width, height = pyautogui.size()

    x = max(0, min(COORD_MAX, int(x)))
    y = max(0, min(COORD_MAX, int(y)))

    screen_x = round(
        x / COORD_MAX * (width - 1)
    )

    screen_y = round(
        y / COORD_MAX * (height - 1)
    )

    return screen_x, screen_y


# ==========================================
# STRUCTURED ACTION SCHEMA
# ==========================================

ACTION_SCHEMA = {
    "type": "object",
    "properties": {
        "action": {
            "type": "string",
            "enum": [
                "move",
                "click",
                "double_click",
                "right_click",
